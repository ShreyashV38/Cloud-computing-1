# ═══════════════════════════════════════════════════════════
# Gateway VM — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in the actual IPs from GCP Console
# cp .env.example .env
# nano .env

# Internal IPs of each microservice VM (GCP Console → VM instances → Internal IP)
PRODUCT_VM_IP=10.128.0.X
SEARCH_VM_IP=10.128.0.X
CART_VM_IP=10.128.0.X
ORDER_VM_IP=10.128.0.X
PAYMENT_VM_IP=10.128.0.X
REVIEW_VM_IP=10.128.0.X
USER_VM_IP=10.128.0.X

# External IP of THIS gateway VM (GCP Console → VM instances → External IP)
GATEWAY_EXTERNAL_IP=34.X.X.X
