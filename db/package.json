{
  "name": "ecom-db",
  "version": "1.0.0",
  "description": "Database layer — Prisma schema, migrations, and seed",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "seed": "npx tsx prisma/seed.ts",
    "studio": "npx prisma studio",
    "reset": "npx prisma db push --force-reset && npm run seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "prisma": "^7.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
